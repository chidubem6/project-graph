# Copy to .env.local, then fill in the two keys below.

# Clerk credentials. Required - the app will not boot without them.
# From https://dashboard.clerk.com -> your instance -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth routes. Not optional in practice. Left unset, Clerk falls back to its
# hosted Account Portal (https://accounts.<domain>/sign-in), so signed-out
# visitors to /dashboard are sent off-site and never reach the sign-in form in
# components/auth/. That fallback works, so nothing errors and nothing logs -
# it just quietly bypasses this app's own auth UI.
#
# Both point at /sign-in: the flow is passwordless, so there is no separate
# sign-up page. Clerk reads these on the client and the server, which is why
# they live here rather than as clerkMiddleware() options.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# Where Clerk sends a user when it chooses the destination itself and there is
# no redirect_url in the path. Currently inert: use-finalize-auth.ts passes its
# own navigate callback and hardcodes /dashboard, so Clerk never gets to decide.
# Kept correct in case that changes - see triage #12.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
