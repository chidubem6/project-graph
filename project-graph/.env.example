# Copy to .env.local, then fill in the two keys below.

# Clerk credentials. Required - the app will not boot without them.
# From https://dashboard.clerk.com -> your instance -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth routes. Not optional in practice. Left unset, Clerk falls back to its
# hosted Account Portal (https://accounts.<domain>/sign-in), so signed-out
# visitors are sent off-site instead of this app's /sign-in and /sign-up pages.
# proxy.ts also reads these two to decide which routes are public.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends a user after signing in or up when there is no
# redirect_url in the path.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/editor
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/editor
